[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
# Switches to a crates.io version once the SDK is published there.
sandchart-indicator = { git = "https://github.com/kennnyz/sandchart", tag = "v0.2.0" }

[profile.release]
opt-level = 3
lto = true
strip = true  # the app refuses modules over 20 MiB
