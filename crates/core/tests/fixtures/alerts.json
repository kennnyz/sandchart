    { "name": "a half rounds away from zero", "level": { "kind": "line", "a": { "t": 0, "p": 0 }, "b": { "t": 2, "p": 1 }, "extendLeft": false, "extendRight": false }, "t": 1, "value": 1 },
    { "name": "minus a half rounds away from zero", "level": { "kind": "line", "a": { "t": 0, "p": 0 }, "b": { "t": 2, "p": -1 }, "extendLeft": false, "extendRight": false }, "t": 1, "value": -1 },
