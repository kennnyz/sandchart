    { "name": "extended left", "level": { "kind": "line", "a": { "t": 1000, "p": 100 }, "b": { "t": 2000, "p": 200 }, "extendLeft": true, "extendRight": false }, "t": 500, "value": 50 },
    { "name": "left is the earlier time even when b comes first", "level": { "kind": "line", "a": { "t": 2000, "p": 200 }, "b": { "t": 1000, "p": 100 }, "extendLeft": true, "extendRight": false }, "t": 0, "value": 0 },
    { "name": "b first, not extended right", "level": { "kind": "line", "a": { "t": 2000, "p": 200 }, "b": { "t": 1000, "p": 100 }, "extendLeft": true, "extendRight": false }, "t": 2500, "value": null },
